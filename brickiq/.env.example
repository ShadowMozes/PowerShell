# Optional: enables the live AI Property Analyst (server-side only, never exposed to the browser)
ANTHROPIC_API_KEY=
# Optional override of the model used by the analyst
BRICKIQ_AI_MODEL=claude-opus-5-5
# Optional: Kadaster BAG Individuele Bevragingen API key. Without it, BrickIQ uses the keyless PDOK BAG WFS.
BAG_API_KEY=
